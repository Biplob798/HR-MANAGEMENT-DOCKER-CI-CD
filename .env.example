# Copy this file to ".env" and fill in your real values.

# Oracle user the website logs in with (use an application user, never SYS)
DB_USER=hr
DB_PASSWORD=change_me

# Format: HOST:PORT/SERVICE_NAME
# Find the service name on the database server with: lsnrctl status <listener_name>
DB_CONNECT_STRING=192.168.0.205:1524/dblcluster